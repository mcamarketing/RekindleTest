{
  "skill_name": "crm_normalization",
  "version": "1.0.0",
  "description": "Transform lead/contact data from various CRMs into canonical Rekindle format with validation and enrichment flags",
  "owners": ["data_team", "platform_team"],
  "created_at": "2025-01-15",
  "last_updated": "2025-01-15",
  "tags": ["normalization", "crm", "data-quality", "etl", "transformation"],
  "dependencies": {
    "required_data": [
      "source_crm",
      "raw_record"
    ],
    "optional_data": [
      "existing_records_for_dedup",
      "exchange_rates"
    ]
  },
  "supported_crms": {
    "tier1": ["salesforce", "hubspot", "pipedrive", "close", "copper"],
    "tier2": ["zoho", "freshsales", "monday", "csv"]
  },
  "outputs": {
    "canonical_record": {
      "email": "string (required, validated)",
      "first_name": "string",
      "last_name": "string",
      "company": "string (required)",
      "phone": "string (E.164 format)",
      "title": "string",
      "industry": "enum (saas|agency|real-estate|restaurant|local-services|ecommerce|finance|healthcare|manufacturing|other)",
      "company_size": "enum (1-10|11-50|51-200|201-1000|1000+|unknown)",
      "deal_value": "number (USD)",
      "last_interaction_date": "ISO 8601 datetime",
      "interaction_count": "number",
      "lead_source": "enum",
      "tags": "array of strings"
    },
    "metadata": {
      "source_crm": "string",
      "normalized_at": "ISO 8601 datetime",
      "quality_score": "number (0-100)",
      "needs_enrichment": "boolean",
      "duplicate_risk": "boolean",
      "validation_warnings": "array of strings"
    }
  },
  "success_criteria": {
    "normalization_success_rate": ">95%",
    "processing_speed": "<200ms per record",
    "email_validation_accuracy": ">99%",
    "data_loss_on_critical_fields": "0%"
  },
  "usage_frequency": "high",
  "execution_mode": "batch",
  "estimated_runtime_ms": 150,
  "cost_per_execution": 0.0002
}
